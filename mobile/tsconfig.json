{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Unit tests run on Node's built-in runner with type stripping, which
    // requires explicit .ts extensions on relative imports.
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
