{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "memory": 2048,
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/privacy",
      "destination": "/api/index"
    },
    {
      "source": "/credits",
      "destination": "/api/index"
    },
    {
      "source": "/screens/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/app",
      "destination": "/api/index"
    },
    {
      "source": "/app/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/",
      "destination": "/api/index"
    }
  ]
}
